NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
# Isolated MariaDB database. Do not use root or another application's database.
DATABASE_URL="mysql://spiritlm_user:password@hostname:3306/spiritlm?connection_limit=3&connect_timeout=15&pool_timeout=15"
CHEAPVIBE_API_KEY=

# Payments are disabled unless the mode is explicitly set to test or live.
CRYPTO_BOT_MODE=test
CRYPTO_BOT_TOKEN_TEST=
CRYPTO_BOT_TOKEN=

# SBP via YooKassa: only test is enabled in the first integration stage.
# SHOP_ID must belong to the test shop that issued SECRET_KEY_TEST.
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY_TEST=
# Reserved for a future live rollout with agreed receipt settings.
YOOKASSA_SECRET_KEY=
